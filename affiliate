    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a href="#how-it-works" class="hover:text-slate-300 transition">How It Works</a>
      <a href="#benefits" class="hover:text-slate-300 transition">Benefits</a>
      <a href="#earnings" class="hover:text-slate-300 transition">Earnings</a>
      <a href="#apply" class="hover:text-slate-300 transition">Apply</a>
    </nav>
    <a href="#apply" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition">Become an Affiliate</a>
  </div>
</header>

<!-- ===================== HERO ===================== -->
<section class="bg-slate-50 border-b border-slate-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight">
      Earn Up To <span class="text-blue-600">10% Profit</span> On Freelancer Projects
    </h1>
    <p class="mt-5 text-lg text-slate-600 max-w-2xl mx-auto">
      PekDigital.com pays up to 10% profit to freelancers and partners for every project they refer. Apply below and start earning.
    </p>
    <a href="#apply" class="inline-block mt-8 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-xl shadow-lg transition">Apply Now →</a>
  </div>
</section>

<!-- ===================== HOW IT WORKS ===================== -->
<section id="how-it-works" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 text-center">How It Works</h2>
  <div class="grid md:grid-cols-3 gap-6 mt-10">
    <div class="rounded-2xl border border-slate-100 p-6">
      <p class="text-blue-600 font-extrabold">01</p>
      <h3 class="font-bold text-slate-900 mt-2">Apply</h3>
      <p class="text-slate-600 text-sm mt-1">Fill the short form below. Approved within 48 hours.</p>
    </div>
    <div class="rounded-2xl border border-slate-100 p-6">
      <p class="text-blue-600 font-extrabold">02</p>
      <h3 class="font-bold text-slate-900 mt-2">Refer</h3>
      <p class="text-slate-600 text-sm mt-1">Share your unique affiliate link with businesses that need our services.</p>
    </div>
    <div class="rounded-2xl border border-slate-100 p-6">
      <p class="text-blue-600 font-extrabold">03</p>
      <h3 class="font-bold text-slate-900 mt-2">Earn</h3>
      <p class="text-slate-600 text-sm mt-1">Get up to 10% profit on every completed project, paid monthly.</p>
    </div>
  </div>
</section>

<!-- ===================== BENEFITS (with your images) ===================== -->
<section id="benefits" class="bg-slate-50 border-y border-slate-100">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 text-center">What You Promote</h2>
    <p class="text-slate-600 text-center mt-3 max-w-xl mx-auto">Every service below earns you up to 10% when a referred project is completed.</p>
    <figure class="mt-10 rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-white">
      <img src="services.png" alt="PekDigital services" class="w-full h-auto">
    </figure>
    <figure class="mt-6 rounded-2xl overflow-hidden shadow-lg border border-slate-200 bg-white">
      <img src="services-stats.png" alt="PekDigital services and stats" class="w-full h-auto">
    </figure>
  </div>
</section>

<!-- ===================== EARNINGS ===================== -->
<section id="earnings" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 text-center">Estimate Your Earnings</h2>
  <div class="mt-8 rounded-2xl border border-slate-100 shadow-lg p-6 md:p-8">
    <label class="block text-sm font-semibold text-slate-700">Project value (USD)</label>
    <input id="pv" type="range" min="100" max="5000" step="50" value="1000" class="w-full mt-2 accent-blue-600">
    <p class="text-blue-700 font-bold mt-1">$<span id="pvOut">1,000</span></p>
    <label class="block text-sm font-semibold text-slate-700 mt-6">Projects per month</label>
    <input id="pc" type="range" min="1" max="20" value="3" class="w-full mt-2 accent-blue-600">
    <p class="text-blue-700 font-bold mt-1"><span id="pcOut">3</span> projects</p>
    <div class="mt-6 rounded-xl bg-slate-900 text-white p-5 flex items-center justify-between">
      <div><p class="text-slate-400 text-xs">Monthly profit (10%)</p><p class="text-2xl md:text-3xl font-extrabold text-emerald-400">$<span id="mOut">300</span></p></div>
      <div class="text-right"><p class="text-slate-400 text-xs">Yearly</p><p class="font-bold">$<span id="yOut">3,600</span></p></div>
    </div>
  </div>
</section>

<!-- ===================== APPLY ===================== -->
<section id="apply" class="bg-slate-900">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="text-2xl md:text-3xl font-extrabold text-white text-center">Apply & Enjoy 10% Profit</h2>
    <p class="text-slate-300 text-center mt-3">Freelancers welcome — we'll email your affiliate link within 48 hours.</p>
    <form id="affiliateForm" class="mt-8 bg-white rounded-2xl shadow-2xl p-6 md:p-8 space-y-5" novalidate>
      <div>
        <label for="fullName" class="block text-sm font-semibold text-slate-700 mb-1.5">Full Name *</label>
        <input id="fullName" name="fullName" type="text" required placeholder="John Doe" class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        <div>
          <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email *</label>
          <input id="email" name="email" type="email" required placeholder="you@example.com" class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label for="phone" class="block text-sm font-semibold text-slate-700 mb-1.5">Phone / WhatsApp *</label>
          <input id="phone" name="phone" type="tel" required placeholder="+254 7XX XXX XXX" class="w-full rounded-xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
      </div>
      <div>
        <label for="skills" class="block text-sm font-semibold text-slate-700 mb-1.5">Your Skill / Niche *</label>
        <select id="skills" name="skills" required class="w-full rounded-xl border border-slate-200 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">Select…</option>
          <option>Social Media Marketing</option>
          <option>Website Design & Development</option>
          <option>SEO Services</option>
          <option>Sales / Business Development</option>
          <option>Other Freelance Services</option>
        </select>
      </div>
      <label class="flex items-start gap-2.5 text-sm text-slate-600">
        <input type="checkbox" required class="mt-0.5 accent-blue-600">
        <span>I agree to the PekDigital affiliate terms, including earning up to <strong>10% profit on referred freelancer projects</strong>.</span>
      </label>
      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl transition">Submit Application →</button>
      <p id="formStatus" class="text-center text-sm font-medium text-blue-700 hidden"></p>
    </form>
  </div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer class="bg-slate-900 text-slate-400 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
    <p class="text-lg font-extrabold text-white">PEKDIGITALS</p>
    <p>© 2026 PekDigital.com — Earn up to 10% profit on freelancer projects.</p>
  </div>
</footer>

<script>
/* ---- Earnings calculator ---- */
const pv = document.getElementById('pv'), pc = document.getElementById('pc');
const fmt = n => n.toLocaleString();
function calc(){
  const v = +pv.value, c = +pc.value;
  document.getElementById('pvOut').textContent = fmt(v);
  document.getElementById('pcOut').textContent = c;
  const m = v * c * 0.10;
  document.getElementById('mOut').textContent = fmt(m);
  document.getElementById('yOut').textContent = fmt(m * 12);
}
pv.addEventListener('input', calc); pc.addEventListener('input', calc); calc();

/* ---- Form: opens the visitor's email app pre-filled to PekDigital support.
   For automatic submissions on GitHub Pages, switch the form to Formspree:
   <form action="https://formspree.io/f/YOUR_ID" method="POST"> ---- */
document.getElementById('affiliateForm').addEventListener('submit', e => {
  e.preventDefault();
  const f = e.target, s = document.getElementById('formStatus');
  if (!f.checkValidity()) { f.reportValidity(); return; }
  const d = Object.fromEntries(new FormData(f).entries());
  const subject = encodeURIComponent('Affiliate Application — ' + d.fullName);
  const body = encodeURIComponent(
    'Full Name: ' + d.fullName + '\nEmail: ' + d.email + '\nPhone: ' + d.phone +
    '\nSkills: ' + d.skills + '\n\nI agree to the affiliate terms (10% profit on freelancer projects).');
  s.textContent = 'Opening your email app to submit…';
  s.classList.remove('hidden');
  window.location.href = 'mailto:support@pekdigital.com?subject=' + subject + '&body=' + body;
});
</script>
</body>
</html>
